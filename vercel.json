{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "api/analyze.js", "use": "@vercel/node" },
    { "src": "api/chat.js", "use": "@vercel/node" },
    { "src": "api/status.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/analyze", "dest": "api/analyze.js" },
    { "src": "/api/chat", "dest": "api/chat.js" },
    { "src": "/api/status", "dest": "api/status.js" },
    { "src": "/styles.css", "dest": "styles.css" },
    { "src": "/app.js", "dest": "app.js" },
    { "src": "/(.*)", "dest": "index.html" }
  ]
}
